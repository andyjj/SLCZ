// Paste this into: Firebase console -> Storage -> Rules -> Publish
//
// Only accounts with the "admin" custom claim (granted via grant_admin.js)
// can upload or read raw sign-submission footage.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
