// Paste this into: Firebase console -> Firestore Database -> Rules -> Publish
//
// Only accounts with the "admin" custom claim (granted via grant_admin.js)
// can read or write sign submissions. Everyone else - including regular
// signed-in app users - has no access to this collection.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
